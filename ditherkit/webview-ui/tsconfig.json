{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "@adobe/cc-ext-uxp-types",
      "@types/photoshop",
      "@types/node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "typeRoots": [
      "../node_modules",
      "../node_modules/@types"
    ]
  },
  "include": [
    "./src",
    "../src",
    "../uxp.config.ts"
  ]
}
