{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "@adobe/cc-ext-uxp-types",
      "@types/photoshop",
      "@types/node"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "./src",
    "./uxp.config.ts",
    "./webview-ui/src/webview.ts",
    "./webview-ui/src/webview-api.ts"
  ]
}
